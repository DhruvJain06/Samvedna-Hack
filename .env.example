# Required environment variables for samvedna-tinyfish
# Copy this file to .env and fill in real values.
# DO NOT commit .env to git.

# --- TinyFish ---
# Set these via:  tinyfish vault set <KEY> "<VALUE>"
# (never put real values in this file)
TINYFISH_VAULT_HRMS_USER=<set-in-tinyfish-vault>
TINYFISH_VAULT_HRMS_PASS=<set-in-tinyfish-vault>

# --- SAMVEDNA API ---
SAMVEDNA_API_BASE=http://127.0.0.1:8090
SAMVEDNA_SERVICE_TOKEN=<set-in-tinyfish-vault>
SAMVEDNA_CONSOLE_URL=http://127.0.0.1:3100
SAMVEDNA_TRUST_TEST_ENV=dev

# --- Force portal ---
TARGET_PORTAL_URL=https://<force-hrms-url>

# --- Demo accounts (used ONLY by trust tests, in dev/staging) ---
SAMVEDNA_DEMO_WO_PASS=<set-in-tinyfish-vault>
SAMVEDNA_DEMO_CO_PASS=<set-in-tinyfish-vault>
SAMVEDNA_DEMO_AU_PASS=<set-in-tinyfish-vault>
SAMVEDNA_DEMO_PERS_PASS=<set-in-tinyfish-vault>

# --- Webhooks ---
ONCALL_WEBHOOK_URL=https://<your-oncall-webhook>
